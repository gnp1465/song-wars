{
  "name": "song-wars-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "check:device-pass-log": "node scripts/check-device-pass-log.mjs",
    "check:ios-tooling": "node scripts/check-ios-tooling.mjs",
    "check:prototype-complete": "npm run verify && npm run check:device-pass-log",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test",
    "test": "npm run check:media && npm run check:playback && npm run check:bracket && npm run check:scoring && npm run check:submissions && npm run check:mock-spotify && npm run check:room && npm run check:prototype-flow",
    "check:media": "node --experimental-strip-types src/tests/manualMediaMocks.ts",
    "check:playback": "node --experimental-strip-types src/tests/manualPlaybackCheck.ts",
    "check:bracket": "node --experimental-strip-types src/tests/manualBracketCheck.ts",
    "check:scoring": "node --experimental-strip-types src/tests/manualScoringCheck.ts",
    "check:submissions": "node --experimental-strip-types src/tests/manualSubmissionCheck.ts",
    "check:mock-spotify": "node --experimental-strip-types src/tests/manualMockSpotifyCheck.ts",
    "check:room": "node --experimental-strip-types src/tests/manualRoomCheck.ts",
    "check:prototype-flow": "node --experimental-strip-types src/tests/manualPrototypeFlowCheck.ts"
  },
  "dependencies": {
    "expo": "^54.0.0",
    "expo-av": "^16.0.0",
    "react": "^19.0.0",
    "react-native": "^0.81.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
