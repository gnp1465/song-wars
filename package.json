{
  "name": "song-wars-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "check:device-pass-log": "node scripts/check-device-pass-log.mjs",
    "check:ios-tooling": "node scripts/check-ios-tooling.mjs",
    "check:online-room": "node scripts/check-online-room.mjs",
    "check:prototype-complete": "npm run verify && npm run check:device-pass-log",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test",
    "test": "npm run check:media && npm run check:playback && npm run check:bracket && npm run check:scoring && npm run check:submissions && npm run check:mock-spotify && npm run check:room && npm run check:prototype-flow && npm run check:online-room-access && npm run check:online-topic && npm run check:online-submissions && npm run check:online-room-schema",
    "check:media": "node --experimental-strip-types src/tests/manualMediaMocks.ts",
    "check:playback": "node --experimental-strip-types src/tests/manualPlaybackCheck.ts",
    "check:bracket": "node --experimental-strip-types src/tests/manualBracketCheck.ts",
    "check:scoring": "node --experimental-strip-types src/tests/manualScoringCheck.ts",
    "check:submissions": "node --experimental-strip-types src/tests/manualSubmissionCheck.ts",
    "check:mock-spotify": "node --experimental-strip-types src/tests/manualMockSpotifyCheck.ts",
    "check:room": "node --experimental-strip-types src/tests/manualRoomCheck.ts",
    "check:prototype-flow": "node --experimental-strip-types src/tests/manualPrototypeFlowCheck.ts",
    "check:online-room-access": "node --experimental-strip-types src/tests/manualOnlineRoomAccessCheck.ts",
    "check:online-topic": "node --experimental-strip-types src/tests/manualOnlineTopicCheck.ts",
    "check:online-submissions": "node --experimental-strip-types src/tests/manualOnlineSubmissionCheck.ts",
    "check:online-room-schema": "node scripts/check-online-room-schema.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.5",
    "expo": "~54.0.36",
    "expo-av": "^16.0.0",
    "expo-constants": "~18.0.13",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "^5.9.0"
  }
}
