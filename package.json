{
  "name": "song-wars-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "check:accessibility-surface": "node scripts/check-accessibility-surface.mjs",
    "check:app-assets": "node scripts/check-app-assets.mjs",
    "check:app-config": "node scripts/check-app-config.mjs",
    "check:app-surface": "node scripts/check-app-surface.mjs",
    "check:beta-build-record": "node scripts/check-beta-build-record.mjs",
    "check:ci-config": "node scripts/check-ci-config.mjs",
    "check:device-pass-log": "node scripts/check-device-pass-log.mjs",
    "check:doc-links": "node scripts/check-doc-links.mjs",
    "check:eas-build-config": "node scripts/check-eas-build-config.mjs",
    "check:ios-tooling": "node scripts/check-ios-tooling.mjs",
    "check:launch-readiness": "node scripts/check-launch-readiness.mjs",
    "check:online-room": "node scripts/check-online-room.mjs",
    "check:secret-safety": "node scripts/check-secret-safety.mjs",
    "check:supabase-env": "node scripts/check-supabase-env.mjs",
    "check:supabase-migration-pass-log": "node scripts/check-supabase-migration-pass-log.mjs",
    "check:supabase-migration-docs": "node scripts/check-supabase-migration-docs.mjs",
    "print:supabase-migrations": "node scripts/print-supabase-migrations.mjs",
    "print:supabase-migrations:core": "SUPABASE_SKIP_REALTIME_PRESENCE_POLICIES=1 node scripts/print-supabase-migrations.mjs",
    "print:supabase-migration": "node scripts/print-supabase-migrations.mjs --file",
    "check:prototype-complete": "npm run verify && npm run check:supabase-migration-pass-log && npm run check:device-pass-log && npm run check:beta-build-record",
    "typecheck": "tsc --noEmit",
    "verify": "npm run check:supabase-env && npm run check:supabase-migration-docs && npm run check:secret-safety && npm run check:accessibility-surface && npm run check:app-assets && npm run check:app-config && npm run check:app-surface && npm run check:ci-config && npm run check:doc-links && npm run check:eas-build-config && npm run check:launch-readiness && npm run typecheck && npm test",
    "test": "npm run check:media && npm run check:storefront && npm run check:playback && npm run check:diagnostics && npm run check:bracket && npm run check:scoring && npm run check:submissions && npm run check:mock-spotify && npm run check:room && npm run check:prototype-flow && npm run check:online-display-name && npm run check:online-room-access && npm run check:online-room-expiry && npm run check:online-room-presence && npm run check:online-room-resume && npm run check:online-topic && npm run check:online-round-display && npm run check:online-round-cleanup && npm run check:online-submission-search-state && npm run check:online-submissions && npm run check:online-judging && npm run check:online-playback-events && npm run check:online-snapshot-mapping && npm run check:online-room-schema",
    "check:media": "node --experimental-strip-types src/tests/manualMediaMocks.ts",
    "check:storefront": "node --experimental-strip-types src/tests/manualStorefrontCheck.ts",
    "check:playback": "node --experimental-strip-types src/tests/manualPlaybackCheck.ts",
    "check:diagnostics": "node --experimental-strip-types src/tests/manualDiagnosticsCheck.ts",
    "check:bracket": "node --experimental-strip-types src/tests/manualBracketCheck.ts",
    "check:scoring": "node --experimental-strip-types src/tests/manualScoringCheck.ts",
    "check:submissions": "node --experimental-strip-types src/tests/manualSubmissionCheck.ts",
    "check:mock-spotify": "node --experimental-strip-types src/tests/manualMockSpotifyCheck.ts",
    "check:room": "node --experimental-strip-types src/tests/manualRoomCheck.ts",
    "check:prototype-flow": "node --experimental-strip-types src/tests/manualPrototypeFlowCheck.ts",
    "check:online-display-name": "node --experimental-strip-types src/tests/manualOnlineDisplayNameCheck.ts",
    "check:online-room-access": "node --experimental-strip-types src/tests/manualOnlineRoomAccessCheck.ts",
    "check:online-room-expiry": "node --experimental-strip-types src/tests/manualOnlineRoomExpiryCheck.ts",
    "check:online-room-presence": "node --experimental-strip-types src/tests/manualOnlineRoomPresenceCheck.ts",
    "check:online-room-resume": "node --experimental-strip-types src/tests/manualOnlineRoomResumeCheck.ts",
    "check:online-topic": "node --experimental-strip-types src/tests/manualOnlineTopicCheck.ts",
    "check:online-round-display": "node --experimental-strip-types src/tests/manualOnlineRoundDisplayCheck.ts",
    "check:online-round-cleanup": "node --experimental-strip-types src/tests/manualOnlineRoundCleanupCheck.ts",
    "check:online-submission-search-state": "node --experimental-strip-types src/tests/manualOnlineSubmissionSearchStateCheck.ts",
    "check:online-submissions": "node --experimental-strip-types src/tests/manualOnlineSubmissionCheck.ts",
    "check:online-judging": "node --experimental-strip-types src/tests/manualOnlineJudgingCheck.ts",
    "check:online-playback-events": "node --experimental-strip-types src/tests/manualOnlinePlaybackEventsCheck.ts",
    "check:online-snapshot-mapping": "node --experimental-strip-types src/tests/manualOnlineSnapshotMappingCheck.ts",
    "check:online-room-schema": "node scripts/check-online-room-schema.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.5",
    "expo": "~54.0.36",
    "expo-av": "^16.0.0",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.23",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "^5.9.0"
  }
}
